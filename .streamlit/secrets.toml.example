# Streamlit 내장 OIDC(Microsoft Entra ID) 설정 — 복사해서 .streamlit/secrets.toml 로 사용
# Entra 앱 등록: 플랫폼 'Web', Redirect URI = {redirect_uri}
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "임의의-긴-랜덤-문자열(32자 이상)"

[auth.microsoft]
client_id = "ENTRA_APP_CLIENT_ID"
client_secret = "ENTRA_APP_CLIENT_SECRET"
# 단일 테넌트로 제한 (다른 회사 계정 로그인 차단)
server_metadata_url = "https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0/.well-known/openid-configuration"
client_kwargs = { prompt = "select_account" }
