# ===== 복사해서 .env 로 사용 (.env 는 절대 GitHub 에 올리지 않는다) =====

# --- 조달청 나라장터 (공공데이터포털 '일반 인증키(Decoding)') ---
SERVICE_KEY=
# G2B_BASE_URL=https://apis.data.go.kr/1230000/ao/PubDataOpnStdService

# --- Supabase (서버 전용 Secret key. 브라우저/클라이언트에 노출 금지) ---
# 비워 두면 가상 데이터 데모로 실행됩니다. 실데이터를 쓸 때만 채우세요.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 예) SUPABASE_URL=https://abcdefgh.supabase.co  /  SUPABASE_SECRET_KEY=sb_secret_...
# auto: Supabase 키가 있으면 Supabase, 없으면 데모(메모리) / supabase / memory
DATA_BACKEND=auto

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4.1
# LLM_PROVIDER=auto   # auto | anthropic | openai | none

# --- 메일 (Microsoft 365 / 일반 SMTP) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Hospital Bid Radar <bidradar@yourcompany.com>
# true 이면 실제 발송 없이 outbox/ 에 .html 로 저장
MAIL_DRY_RUN=true

# --- Teams 채널 알림 (선택): 채널 > 워크플로 > '웹후크 요청을 받으면 채널에 게시' 로 발급한 URL (비밀!) ---
TEAMS_WEBHOOK_URL=

# --- Slack 채널 알림 (선택): Slack 앱 > Incoming Webhooks 로 발급한 URL (비밀!) ---
SLACK_WEBHOOK_URL=

# --- 카카오 알림톡 (선택): 대행사 Solapi + 카카오 비즈채널 + 승인된 템플릿 필요 ---
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
KAKAO_PF_ID=
KAKAO_SENDER=
KAKAO_TPL_ALERT=
KAKAO_TPL_REPORT=

# --- 앱 / 인증 ---
# true 이면 로그인 없이 개발자(admin)로 진입 — 로컬 데모 전용. 운영(Streamlit Cloud/Azure)에서는 반드시 false
AUTH_DISABLED=true
# password: 이메일로 가입 신청 → 관리자 승인 후 로그인 (기본, 일반 메일 계정 가능) / entra: Microsoft 로그인
AUTH_MODE=password
# 최초 관리자 생성용 일회성 코드(길고 임의의 문자열). 가입 화면의 '관리자 초기 설정 코드'에 입력한 첫 계정만
# 관리자가 되며, 활성 관리자가 한 명이라도 있으면 이 코드는 무효입니다. (이메일 가입은 Supabase 연결 필요 — 데모 모드는 재시작 시 사라짐)
ADMIN_SETUP_CODE=
# 허용할 이메일 도메인(쉼표 구분). 비우면 모든 메일 주소로 가입 신청 가능(관리자 승인은 필수)
ALLOWED_EMAIL_DOMAINS=
# AUTH_MODE=entra 일 때만 사용
ADMIN_EMAILS=
AUTO_PROVISION=true
APP_BASE_URL=http://localhost:8501
OWN_COMPANY=SK플라즈마
