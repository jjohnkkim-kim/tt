# ===== 복사해서 .env 로 사용 (.env 는 절대 GitHub 에 올리지 않는다) =====

# --- 조달청 나라장터 (공공데이터포털 '일반 인증키(Decoding)') ---
SERVICE_KEY=YOUR_SERVICE_KEY
# G2B_BASE_URL=https://apis.data.go.kr/1230000/ao/PubDataOpnStdService

# --- Supabase (서버 전용 Secret key. 브라우저/클라이언트에 노출 금지) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# auto: Supabase 키가 있으면 Supabase, 없으면 데모(메모리) / supabase / memory
DATA_BACKEND=auto

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4.1
# LLM_PROVIDER=auto   # auto | anthropic | openai | none

# --- 메일 (Microsoft 365 / 일반 SMTP) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Hospital Bid Radar <bidradar@yourcompany.com>
# true 이면 실제 발송 없이 outbox/ 에 .html 로 저장
MAIL_DRY_RUN=true

# --- 앱 / 인증 ---
# true 이면 로그인 없이 개발자(admin)로 진입 — 운영(Azure)에서는 반드시 false
AUTH_DISABLED=true
ADMIN_EMAILS=you@yourcompany.com
ALLOWED_EMAIL_DOMAINS=yourcompany.com
AUTO_PROVISION=true
APP_BASE_URL=http://localhost:8501
OWN_COMPANY=SK플라즈마

# --- 텔레그램 푸시 (선택): @BotFather 로 봇 생성 → 토큰, 봇에게 /start 후 `python scripts/send_telegram.py --find-chat-id` ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 메일 구독 화면 (사이드바 '메일 구독') ---
# 인증코드 서명용 비밀값. 비우면 SUPABASE_SECRET_KEY 를 대신 사용
SUBSCRIBE_SECRET=
# 구독 허용 도메인 (쉼표 구분). 비우면 제한 없음
SUBSCRIBE_ALLOWED_DOMAINS=
